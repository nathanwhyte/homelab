[Unit]
Description=Ollama model preparation and verified runtime adoption
# PartOf: stopping/restarting ollama.service restarts this unit too, so the
# warm re-runs after every daemon restart — the host equivalent of the retired
# pod's `startup.sh & exec ollama serve` (IMPR-1075).
After=ollama.service
Requires=ollama.service
PartOf=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=ollama
Group=ollama
Environment="OLLAMA_URL=http://127.0.0.1:11434"
Environment="MODELFILE_DIR=/opt/ollama-host/modelfiles"
Environment="OLLAMA_PREPARATION_STATE=/var/lib/ollama-preparation"
# The daemon remains ollama-owned. Only this root-owned administrative verifier
# needs /proc, journal evidence and pidfd authority to stop its exact daemon on
# failed adoption; callers cannot supply arbitrary executable paths or settings.
ExecStart=+/opt/ollama-host/ollama-warm.sh
# The module bounds each request; a cold model store can need long downloads.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
