# OpenViking API Key Secret for Hermes Agent
#
# This Secret must exist in the 'hermes' namespace so the Hermes pod can
# authenticate with the OpenViking service in the 'viking' namespace.
# Kubernetes does not support cross-namespace secretKeyRef.
#
# Create it by copying the actual value from the viking namespace:
#   kubectl get secret openviking-api-key -n viking -o jsonpath='{.data.api-key}' \
#     | base64 -d \
#     | kubectl create secret generic openviking-api-key \
#         --namespace=hermes \
#         --from-literal=api-key=- \
#         --dry-run=client -o yaml \
#     | kubectl apply -f -
#
# Or generate a fresh key and update both namespaces:
#   NEW_KEY=$(openssl rand -base64 32)
#   kubectl create secret generic openviking-api-key \
#       --namespace=hermes \
#       --from-literal=api-key="$NEW_KEY" \
#       --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic openviking-api-key \
#       --namespace=viking \
#       --from-literal=api-key="$NEW_KEY" \
#       --dry-run=client -o yaml | kubectl apply -f -
#
# After creating/updating this Secret, restart Hermes:
#   kubectl rollout restart deploy/hermes-agent -n hermes
#
apiVersion: v1
kind: Secret
metadata:
  name: openviking-api-key
  namespace: hermes
type: Opaque
data:
  api-key: PASTE_YOUR_API_KEY_HERE