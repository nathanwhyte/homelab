<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  System LaunchDaemon for the Apple Silicon GPU/ANE/SoC exporter.

  Runs as root because `powermetrics` requires root.

  The script path below lives under `main/` because ~/code/homelab is a bare
  repo with sibling worktrees (see ../README.md). The pre-migration path,
  ~/code/homelab/mac/exporters/..., stopped existing at that move, and this
  daemon then failed on every retry with `No such file or directory` — 10781
  runs, exit 2, and no metric on :9112 — until BUG-1212's work surfaced it.
  Do not tidy it back to a path without `main/`.

  Install:
    sudo cp com.nathanwhyte.mac-gpu-exporter.plist /Library/LaunchDaemons/
    sudo chown root:wheel /Library/LaunchDaemons/com.nathanwhyte.mac-gpu-exporter.plist
    sudo launchctl load /Library/LaunchDaemons/com.nathanwhyte.mac-gpu-exporter.plist

  Listens on :9112.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nathanwhyte.mac-gpu-exporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>/Users/noot/code/homelab/main/mac/exporters/mac-gpu-exporter.py</string>
    <string>--port</string>
    <string>9112</string>
    <string>--interval</string>
    <string>5</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>UserName</key>
  <string>root</string>

  <key>StandardOutPath</key>
  <string>/var/log/mac-gpu-exporter.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/mac-gpu-exporter.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
