<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent for the macbook-backup freshness exporter.

  Reports the age of ~/Library/Application Support/macbook-backup/last-success,
  which bin/macbook-backup.sh stamps only when every source uploaded cleanly.
  Needs no root: it stats a user-owned file, unlike the powermetrics-based
  GPU exporter this replaces (retired with mac_gpu_* in BUG-1212's follow-up).

  The script path lives under main/ because ~/code/homelab is a bare repo with
  sibling worktrees (see ../README.md) — the same layout change that silently
  killed its predecessor, which kept pointing at a pre-migration path and
  failed 10781 times without anyone noticing.

  Install:
    cp macbook-backup-exporter.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nathanwhyte.macbook-backup-exporter.plist

  Verify:
    curl -fsS localhost:9114/metrics | grep ^macbook_backup

  Uninstall:
    launchctl bootout gui/$(id -u)/com.nathanwhyte.macbook-backup-exporter
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nathanwhyte.macbook-backup-exporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>/Users/noot/code/homelab/main/mac/exporters/macbook-backup-exporter.py</string>
    <string>--port</string>
    <string>9114</string>
    <string>--interval</string>
    <string>15</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/noot/.local/share/macbook-backup-exporter/exporter.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/noot/.local/share/macbook-backup-exporter/exporter.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
