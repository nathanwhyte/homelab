---
# R2 credentials for the rclone bootstrap Job and weekly backup CronJob.
#
# Copy this file to `r2-credentials.secret.yaml` (gitignored) and fill in
# a Cloudflare R2 API token scoped to the `homelab` bucket with object
# read+write (Edit) permissions. The operator scripts under `scripts/`
# read their keys from `R2_AK` / `R2_SK` and never carry defaults.
#
# Apply:
#   kubectl apply -f media/yt-dlp/r2-credentials.secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: r2-credentials
  namespace: yt-dlp
type: Opaque
stringData:
  # rclone reads RCLONE_CONFIG_<REMOTE>_* env vars and synthesizes a
  # remote called <remote> at runtime — no rclone.conf file needed.
  # Remote name here is "r2".
  RCLONE_CONFIG_R2_TYPE: "s3"
  RCLONE_CONFIG_R2_PROVIDER: "Cloudflare"
  RCLONE_CONFIG_R2_ENDPOINT: "https://e9f17cd063113cea9c2e73c302971066.r2.cloudflarestorage.com"
  RCLONE_CONFIG_R2_ACCESS_KEY_ID: "REPLACE_ME"
  RCLONE_CONFIG_R2_SECRET_ACCESS_KEY: "REPLACE_ME"
  RCLONE_CONFIG_R2_REGION: "auto"
  RCLONE_CONFIG_R2_NO_CHECK_BUCKET: "true"
