# GitHub registration credential for the runner scale sets (IDEA-1094).
#
# Copy to github-config-secret.yaml, fill in a real token, apply, and DO NOT
# commit the copy (the repo .gitignore covers **/*secret*.yaml; this file
# deliberately keeps the .example suffix in git).
#
# Token requirements (personal account, repo-level runner scale sets):
#   - Fine-grained PAT scoped to the target private repos with
#     "Administration: Read and write" repository permission, OR
#   - a classic PAT with the `repo` scope.
# The same secret is shared by every runner scale set in arc-runners.
#
# PRIVATE REPOS ONLY: never point a scale set at a public repo
# (nathanwhyte/homelab is public) — a self-hosted runner on a public repo
# executes fork-PR code on the cluster.
apiVersion: v1
kind: Secret
metadata:
  name: github-config-secret
  namespace: arc-runners
type: Opaque
stringData:
  github_token: "<FINE-GRAINED-PAT>"
