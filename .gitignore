# Sensitive files - tokens and credentials
**/kube-token.txt
**/*token*.txt
**/*secret*.yaml
**/*secret*.yml
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/*.pfx
**/htpasswd

# Kubernetes temporary files
*.kubeconfig
kubeconfig
.kube/

# Helm
.helm/
**/charts/

# Environment files
.env
.env.local
.env.*.local

# Backup files
*.bak
*.backup

# Editor and IDE files
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# MCP config (contains API keys)
.mcp.json
opencode.json

# Generated caches
**/.index-cache.json

# Python
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Rust (garage vendored source)
**/target/

# Shell
*.log
.claude/index/

# uv lock files
uv-*.lock

# Downloaded model weights (large, not source)
*.gguf
*.safetensors
vllm/models/

# Node compile cache
node-compile-cache/

# Lock files
*.lock

# Nested git repositories
garage/garage/
mac/exporters/__pycache__/

backups/

.worktrees/

# Benchmark results are ignored by default (raw run output is bulky and
# machine-local), but curated evidence backing a published report is tracked —
# re-included explicitly below. A `dir/` pattern would block re-inclusion of
# anything inside it, hence `dir/*`.
benchmarks/results/*
!benchmarks/results/authoritative-20260731/
!benchmarks/results/authoritative-20260731/*.log
!benchmarks/results/authoritative-20260801/
!benchmarks/results/authoritative-20260801/*.log
!benchmarks/results/agentic-coding-gemma4_26b-mxfp8-20260801-102000.json
!benchmarks/results/agentic-coding-gemma4_31b-nvfp4-20260801-102905.json
!benchmarks/results/prefill-gemma4-31b-nvfp4.json
!benchmarks/results/prefill-gemma4-31b-nvfp4.log
# IDEA-1090 FIM-vs-agent contention baseline on 0.33.1 (README + 2 logs + 2 json summaries)
!benchmarks/results/fim-contention-20260828-v0.33.1/
# IDEA-1090/1091 partner-model gate on the real batch skills (README + cases + per-model json + logs)
!benchmarks/results/batch-skill-gate-20260828/
# IDEA-1090 pairing measurements: slot probes, 3B FIM side, FIM+partner cohabitation (run.py + logs + json)
!benchmarks/results/pair-cohab-20260828/
# IDEA-1091 fence.propose v2 mistag gate (README + cases + per-model json)
!benchmarks/results/fence-mistag-20260830/

# Pi-hole stack secrets (PROJ-1018). pihole-exporter.env carries a Pi-hole
# password per upstream's schema and is NOT matched by the bare `.env` rule above.
network/pihole/**/.env
pihole-exporter.env
