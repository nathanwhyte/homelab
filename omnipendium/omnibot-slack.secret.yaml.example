# Omnibot credentials: Slack socket-mode tokens + Ollama Cloud API key.
# Copy to omnibot-slack.secret.yaml, fill values from the omnipendium repo's
# .env (personal-workspace app A0BF7RANL3G), then:
#   kubectl apply -f omnibot-slack.secret.yaml
# Or create directly without a file on disk:
#   kubectl create secret generic omnibot-slack -n omnipendium \
#     --from-literal=OMNIPENDIUM_SLACK_APP_TOKEN=xapp-... \
#     --from-literal=OMNIPENDIUM_SLACK_BOT_USER_OAUTH_TOKEN=xoxb-... \
#     --from-literal=OMNIPENDIUM_SLACK_CHANNEL_ID=C... \
#     --from-literal=OMNIPENDIUM_OLLAMA_API_KEY=...
apiVersion: v1
kind: Secret
metadata:
  name: omnibot-slack
  namespace: omnipendium
type: Opaque
stringData:
  OMNIPENDIUM_SLACK_APP_TOKEN: CHANGE_ME # xapp-…, socket-mode connections
  OMNIPENDIUM_SLACK_BOT_USER_OAUTH_TOKEN: CHANGE_ME # xoxb-…, Web API
  OMNIPENDIUM_SLACK_CHANNEL_ID: CHANGE_ME
  OMNIPENDIUM_OLLAMA_API_KEY: CHANGE_ME # Ollama Cloud (synthesis)
