# Omnipendium Postgres credentials.
# Copy to omnipendium-db.secret.yaml, replace CHANGE_ME (same password in
# both keys), then: kubectl apply -f omnipendium-db.secret.yaml
# The real file is gitignored (*.secret.yaml).
apiVersion: v1
kind: Secret
metadata:
  name: omnipendium-db
  namespace: omnipendium
type: Opaque
stringData:
  POSTGRES_PASSWORD: CHANGE_ME
  OMNIPENDIUM_DATABASE_URL: <DATABASE_URL> # postgresql+asyncpg://omnipendium:<POSTGRES_PASSWORD>@omnipendium-db:5432/omnipendium
