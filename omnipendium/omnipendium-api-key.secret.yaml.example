# Omnipendium API Bearer key (checked by the app on every route except /health).
# Copy to omnipendium-api-key.secret.yaml, fill in a generated key
# (e.g. `openssl rand -hex 32`), then: kubectl apply -f omnipendium-api-key.secret.yaml
# Clients send: Authorization: Bearer <key>
apiVersion: v1
kind: Secret
metadata:
  name: omnipendium-api-key
  namespace: omnipendium
type: Opaque
stringData:
  OMNIPENDIUM_API_KEY: CHANGE_ME
