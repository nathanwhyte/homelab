---
# OpenViking API key secret.
#
# Copy to openviking-api-key.secret.yaml and fill in your API key:
#   cp viking/openviking-api-key.secret.yaml.example viking/openviking-api-key.secret.yaml
#   # edit the file with your API key
#   kubectl apply -f viking/openviking-api-key.secret.yaml
#
# The root key is injected into ov.conf. The user key is used by in-pod helper
# tools such as the metrics exporter. In small installs both can be the same
# value, but keeping separate keys makes future rotation easier.
apiVersion: v1
kind: Secret
metadata:
  name: openviking-api-key
  namespace: viking
type: Opaque
stringData:
  api-key: "ROOT_TOKEN_PLACEHOLDER"
  user-api-key: "USER_TOKEN_PLACEHOLDER"
