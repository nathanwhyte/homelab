---
# Claude Console API key for OpenViking's VLM when it points at a Claude model
# (IMPR-1311: Haiku 5.5 on the Max plan's monthly API credit). The config-rewrite
# init container injects it into vlm.api_key when the template's value is
# "${ANTHROPIC_KEY}". The key is not workspace-scoped, so the VLM config also sends
# the workspace through vlm.extra_headers (anthropic-workspace-id).
# Create it from the local key file without writing the value to disk:
#   kubectl create secret generic anthropic-vlm-key -n viking \
#     --from-file=API_KEY=$HOME/code/keys/claude-console-api-key-openviking-vlm.txt
apiVersion: v1
kind: Secret
metadata:
  name: anthropic-vlm-key
  namespace: viking
type: Opaque
stringData:
  API_KEY: REPLACE_WITH_CLAUDE_CONSOLE_API_KEY
