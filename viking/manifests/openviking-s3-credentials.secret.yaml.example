---
# Copy to openviking-s3-credentials.secret.yaml, fill in Garage credentials,
# then apply: kubectl apply -f viking/openviking-s3-credentials.secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: openviking-s3-credentials
  namespace: viking
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "<GARAGE_ACCESS_KEY>"
  AWS_SECRET_ACCESS_KEY: "<GARAGE_SECRET_KEY>"
