---
# Secrets for the LiteLLM VLM router and its Redis (IMPR-1311). Both values are
# generated, not copied from anywhere. Create without writing them to disk:
#   kubectl create secret generic litellm-vlm -n viking \
#     --from-literal=LITELLM_MASTER_KEY="sk-$(openssl rand -hex 24)" \
#     --from-literal=REDIS_PASSWORD="$(openssl rand -hex 24)"
# OpenViking reads LITELLM_MASTER_KEY too: its config-rewrite init container injects it
# into vlm.api_key when the template's value is "${LITELLM_KEY}".
apiVersion: v1
kind: Secret
metadata:
  name: litellm-vlm
  namespace: viking
type: Opaque
stringData:
  LITELLM_MASTER_KEY: <SK_PREFIXED_RANDOM_KEY>
  REDIS_PASSWORD: <RANDOM_PASSWORD>
