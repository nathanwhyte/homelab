---
# Bearer token for the llama-namespace ollama auth proxy, duplicated into
# the viking namespace so the config-rewrite init container can inject it
# into vlm.api_key (cloud VLM primary via chat-ollama — IDEA-1050).
# Copy to ollama-api-key.secret.yaml with the real value (must match
# llama/ollama-api-key API_KEY):
#   kubectl get secret ollama-api-key -n llama -o jsonpath='{.data.API_KEY}'
apiVersion: v1
kind: Secret
metadata:
  name: ollama-api-key
  namespace: viking
type: Opaque
stringData:
  API_KEY: REPLACE_WITH_OLLAMA_AUTH_PROXY_BEARER
