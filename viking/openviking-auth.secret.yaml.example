---
# Traefik basicAuth credentials for OpenViking ingress.
#
# Generate credentials:
#   TOKEN=$(openssl rand -base64 32)
#   echo "Save this token: $TOKEN"
#   htpasswd -nb api "$TOKEN"
#
# Paste the htpasswd output into the 'users' field below, then:
#   cp viking/openviking-auth.secret.yaml.example viking/openviking-auth.secret.yaml
#   # edit the file with your htpasswd line
#   kubectl apply -f viking/openviking-auth.secret.yaml
#
# Clients authenticate with: Authorization: Basic base64("api:<TOKEN>")
apiVersion: v1
kind: Secret
metadata:
  name: openviking-auth-secret
  namespace: viking
type: Opaque
stringData:
  users: "api:$apr1$REPLACE_WITH_HTPASSWD_HASH"
