---
apiVersion: v1
kind: Secret
metadata:
  name: mem0-secrets
  namespace: mem0
type: Opaque
stringData:
  # Postgres credentials — change these before applying
  POSTGRES_PASSWORD: CHANGE_ME_POSTGRES_PASSWORD
  # Admin API key for Mem0 server — Hermes uses this
  ADMIN_API_KEY: CHANGE_ME_MEM0_ADMIN_API_KEY
  # JWT secret for Mem0 auth
  JWT_SECRET: CHANGE_ME_JWT_SECRET