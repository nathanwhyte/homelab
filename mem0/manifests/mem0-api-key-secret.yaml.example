---
# Mem0 API key secret for the hermes namespace.
# The Mem0 admin key is stored in the mem0 namespace (mem0-secrets),
# but Hermes needs it in its own namespace. Create this secret with the
# same ADMIN_API_KEY value as mem0/mem0-secrets.
#
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 32
# Then: kubectl create secret generic mem0-api-key --from-literal=ADMIN_API_KEY=<value> -n hermes
apiVersion: v1
kind: Secret
metadata:
  name: mem0-api-key
  namespace: hermes
type: Opaque
stringData:
  ADMIN_API_KEY: CHANGE_ME_MEM0_ADMIN_API_KEY