# Example only — never commit the real secret (BUG-1029). Create out-of-band:
#   kubectl -n kube-system create secret generic k3s-backup-s3-credentials \
#     --from-literal=ACCESS_KEY_ID=<garage key id> \
#     --from-literal=SECRET_ACCESS_KEY=<garage secret>
---
apiVersion: v1
kind: Secret
metadata:
  name: k3s-backup-s3-credentials
  namespace: kube-system
type: Opaque
stringData:
  ACCESS_KEY_ID: "REPLACE_ME"
  SECRET_ACCESS_KEY: "REPLACE_ME"
