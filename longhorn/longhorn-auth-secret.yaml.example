# Example for `longhorn-auth-secret` — BasicAuth credentials for the Longhorn UI
# (IMPR-1020). Copy to longhorn-auth-secret.yaml, fill in a real bcrypt hash, and
# apply. The real file is gitignored (**/*secret*.yaml).
#
# Longhorn's frontend has no authentication of its own, so this secret is the
# only thing standing between a LAN/tailnet client and a storage admin console
# that can detach and delete volumes.
#
# GENERATE the htpasswd line (bcrypt — Traefik also accepts MD5/apr1 and SHA1,
# but prefer bcrypt):
#
#   htpasswd -nbB admin '<password>'
#
# Produces: admin:$2y$05$<53-char bcrypt hash>
#
# APPLY without ever writing the password to a file in this repo:
#
#   htpasswd -nbB admin '<password>' > users.txt
#   kubectl create secret generic longhorn-auth-secret -n longhorn-system \
#     --from-file=users=users.txt --dry-run=client -o yaml | kubectl apply -f -
#   rm users.txt
#
# ROTATION: rerun the two commands above with a new password. Traefik picks the
# secret up without a restart — the kubernetescrd provider watches it. Confirm
# with the negative test afterwards (no credentials must return 401):
#
#   curl -so /dev/null -w '%{http_code}' https://longhorn.nathanwhyte.dev/
#
# NOTE ON YAML: the `users` value below is base64 of the FULL htpasswd line
# (`admin:$2y$...`), not of the hash alone. If you hand-write this file rather
# than using `kubectl create secret` above, mind that `$` needs no escaping in
# base64 but does inside an unquoted stringData block — prefer `data` + base64.
---
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-auth-secret
  namespace: longhorn-system
type: Opaque
data:
  # base64 of: admin:$2y$05$REPLACE_WITH_REAL_BCRYPT_HASH
  users: YWRtaW46JDJ5JDA1JFJFUExBQ0VfV0lUSF9SRUFMX0JDUllQVF9IQVNI
