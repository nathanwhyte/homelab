---
# Copy this file to r2-backup-target.secret.yaml, fill in real credentials,
# then rerun deploy-longhorn.sh or apply it manually.
apiVersion: v1
kind: Secret
metadata:
  name: longhorn-r2-backup-target
  namespace: longhorn-system
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "<R2_ACCESS_KEY_ID>"
  AWS_SECRET_ACCESS_KEY: "<R2_SECRET_ACCESS_KEY>"
  AWS_ENDPOINTS: "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
  # Uncomment only if Longhorn reports bucket addressing errors.
  # VIRTUAL_HOSTED_STYLE: "true"
