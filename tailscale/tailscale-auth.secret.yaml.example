# Tailscale auth key for the in-cluster subnet router.
#
# 1. Create a tailnet (free): https://login.tailscale.com/start
# 2. Generate a REUSABLE, PRE-AUTHORIZED auth key (so the pod can re-register on
#    restart without manual approval):
#      Admin console → Settings → Keys → Generate auth key
#        ✅ Reusable
#        ✅ Pre-approved (skip device approval)
#        (optional) Tag the key, e.g. tag:k8s-subnet-router, and add the tag to
#        your ACLs so the router is policy-managed.
# 3. Copy this file and paste the key, then apply:
#      cp tailscale/tailscale-auth.secret.yaml.example tailscale/tailscale-auth.secret.yaml
#      # edit the file: set TS_AUTHKEY below
#      kubectl apply -f tailscale/tailscale-auth.secret.yaml
#
# tailscale-auth.secret.yaml is gitignored — never commit the real key.
apiVersion: v1
kind: Secret
metadata:
  name: tailscale-auth
  namespace: tailscale
type: Opaque
stringData:
  TS_AUTHKEY: "tskey-auth-REPLACE-ME"
