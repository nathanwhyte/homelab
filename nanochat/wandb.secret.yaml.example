---
# Copy to nanochat/wandb.secret.yaml, fill in your API key, then apply:
#   kubectl apply -f nanochat/wandb.secret.yaml
#
# Get your API key from: https://wandb.ai/authorize
apiVersion: v1
kind: Secret
metadata:
  name: wandb-api-key
  namespace: nanochat
type: Opaque
stringData:
  WANDB_API_KEY: "<YOUR_WANDB_API_KEY>"
