FROM rocm/pytorch:rocm7.2_ubuntu24.04_py3.12_pytorch_release_2.9.1

RUN apt-get update && apt-get install -y git curl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv

WORKDIR /app
RUN git clone https://github.com/karpathy/nanochat.git .

# Create venv that inherits system ROCm torch, then install all other deps
RUN uv venv --system-site-packages && \
    uv sync --no-install-package torch

ENV PATH="/app/.venv/bin:$PATH"

# ROCm PyTorch perf tuning (these are real PyTorch env vars)
ENV PYTORCH_TUNABLEOP_ENABLED=1
ENV PYTORCH_ALLOC_CONF=expandable_segments:True
# Force bf16 — RDNA 4 supports it but nanochat's SM-version check may misdetect
ENV NANOCHAT_DTYPE=bfloat16
